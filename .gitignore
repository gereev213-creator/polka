# Сборка фронтенда и зависимости — восстанавливаются в Docker-сборке
node_modules/
dist/
build/

# Виртуальные окружения
.venv/
venv/

# Python
__pycache__/
*.pyc

# IDE / OS
.idea/
.DS_Store

# Локальные данные и сессии — не должны попадать в образ и в git
*.session
*.db
*.db-shm
*.db-wal
*.db-journal

# Конфиг сборщика содержит токен приёма находок
collector/config.json

# состояние ротации целей — создаётся сборщиком при работе
collector/targets_state.json

# cookies сборщика — локальные сессии, не для репозитория
collector/cookies.json
# Готовый фронтенд лежит в репозитории: BOTHOST собирает без Node,
# поэтому dist нужен в git (в .dockerignore он тоже разрешён).
!polka-final/frontend/dist/
!polka-final/frontend/dist/**
